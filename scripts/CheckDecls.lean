module

import Lean

/-!
# Check declarations referenced by the blueprint

This executable implements the interface used by `leanblueprint checkdecls`:

    lake exe checkdecls blueprint/lean_decls

Run with `--docs` to additionally write a local declaration index at
`blueprint/docs/find/index.html`. Its anchors match leanblueprint's
`find/#doc/DECLARATION` links. It reads the compiled exported environment;
source-text matches and private declarations do not count as existing names.
-/

open Lean

namespace CheckDecls

private def usage : String :=
  "Usage: lake exe checkdecls [blueprint/lean_decls] [--docs]\n" ++
  "Checks public declarations imported by Omega. --docs also generates the local declaration index."

private def parseNames (contents : String) : List String :=
  ((contents.splitOn "\n").map (·.trimAscii.toString)).filter
    (fun line => !line.isEmpty && !line.startsWith "#") |>.eraseDups

private def escapeHtml (text : String) : String :=
  let text := text.replace "&" "&amp;"
  let text := text.replace "<" "&lt;"
  let text := text.replace ">" "&gt;"
  let text := text.replace "\"" "&quot;"
  text.replace "'" "&#39;"

private def sourceModule (env : Environment) (name : Name) : String :=
  match env.getModuleIdxFor? name with
  | some idx => env.header.moduleNames[idx]!.toString
  | none => "Omega"

private def declarationHtml (env : Environment) (info : ConstantInfo) : IO String := do
  let name := info.name.toString
  let moduleName := sourceModule env info.name
  let typeText ← try
    let options := ({} : Options).set `pp.width (100 : Nat)
    let formatted ← PrettyPrinter.ppExprLegacy env {} {} options info.type
    pure (formatted.pretty 100)
  catch _ =>
    -- Raw expressions are still read from the compiled declaration. This
    -- fallback keeps documentation generation independent of custom printers.
    pure (toString info.type)
  return "<section class=\"declaration\" id=\"doc/" ++ escapeHtml name ++ "\">\n" ++
    "<h2><a href=\"#doc/" ++ escapeHtml name ++ "\"><code>" ++ escapeHtml name ++
    "</code></a></h2>\n<p class=\"metadata\">Source: <code>" ++
    escapeHtml (moduleName.replace "." "/" ++ ".lean") ++ "</code></p>\n" ++
    "<pre><code>" ++ escapeHtml typeText ++ "</code></pre>\n</section>\n"

private def writeDocs (env : Environment) (infos : Array ConstantInfo) : IO Unit := do
  let mut sections := ""
  for info in infos do
    sections := sections ++ (← declarationHtml env info)
  let html := "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n" ++
    "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n" ++
    "<title>Omega · Lean declaration index</title>\n<style>" ++
    "body{font:16px/1.55 system-ui,sans-serif;max-width:1100px;margin:3rem auto;padding:0 1.5rem;color:#1c2630;background:#fafbfc}" ++
    "h1{font-size:2rem}h2{font-size:1rem;overflow-wrap:anywhere}a{color:#124b78}code{font-family:ui-monospace,monospace}" ++
    ".metadata{color:#536170;font-size:.9rem}.declaration{background:white;border:1px solid #d7dfe7;border-radius:8px;padding:1rem 1.3rem;margin:1rem 0;scroll-margin:1rem}" ++
    ".declaration:target{border-color:#12688f;box-shadow:0 0 0 2px #c9e6f3}pre{overflow-x:auto;white-space:pre-wrap;overflow-wrap:anywhere;font-size:.88rem}" ++
    "</style></head><body>\n<header><h1>Lean declaration index</h1>\n" ++
    "<p>Declarations referenced by the Omega blueprint, checked against the compiled public Lean environment.</p>" ++
    "<p class=\"metadata\">" ++ toString infos.size ++ " declarations · generated by <code>lake exe checkdecls --docs</code></p></header>\n" ++
    "<main>\n" ++ sections ++ "</main></body></html>\n"
  let directory : System.FilePath := "blueprint/docs/find"
  IO.FS.createDirAll directory
  IO.FS.writeFile (directory / "index.html") html
  IO.println s!"Wrote declaration index: {directory / "index.html"}"

private def run (args : List String) : IO UInt32 := do
  if args.contains "--help" || args.contains "-h" then
    IO.println usage
    return 0
  let docs := args.contains "--docs"
  let positional := args.filter (· != "--docs")
  let path ← match positional with
    | [] => pure "blueprint/lean_decls"
    | [path] =>
      if path.startsWith "-" then
        throw <| IO.userError usage
      pure path
    | _ => throw <| IO.userError usage
  let names := parseNames (← IO.FS.readFile path)
  if names.isEmpty then
    throw <| IO.userError s!"No declarations found in {path}; generate the blueprint first."
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Omega }] {} (level := .exported)
  let mut missing : Array String := #[]
  let mut infos : Array ConstantInfo := #[]
  for text in names.mergeSort do
    let name := text.toName
    if isPrivateName name then
      missing := missing.push text
    else if let some info := env.find? name then
      infos := infos.push info
    else
      missing := missing.push text
  unless missing.isEmpty do
    for name in missing do
      IO.eprintln s!"Missing public declaration: {name}"
    IO.eprintln s!"Declaration check failed: {missing.size} of {names.length} names missing."
    return 1
  IO.println s!"Declaration check passed: {names.length} public declarations."
  if docs then writeDocs env infos
  return 0

end CheckDecls

public def main (args : List String) : IO UInt32 := do
  try
    CheckDecls.run args
  catch error =>
    IO.eprintln s!"checkdecls: {error}"
    return 1
